SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Dev Dashboard apps use a Client ID + Client Secret (client credentials grant)
# instead of a static shpat_ token. The app code exchanges these for a
# short-lived (24h) access token automatically - see shopify_client.py.
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret
SHOPIFY_API_VERSION=2026-04
# NOTE: deliberately NO ANTHROPIC_API_KEY here - evals run via `claude -p` on the
# user's Pro plan Agent SDK credit. An API key would trigger paid API billing.
CACHE_TTL_SECONDS=300
CACHE_ENABLED=true
